services:
    phpstanCwe.ignoreCollector:
        class: Perturbatio\PhpstanCwe\Ignore\CweIgnoreCollector
        tags:
            - phpstan.collector
    -
        class: Perturbatio\PhpstanCwe\Rules\Cwe89\Cwe89LaravelCollector
        tags:
            - phpstan.collector
    phpstanCwe.cwe89Rule:
        class: Perturbatio\PhpstanCwe\Rules\Cwe89\Cwe89Rule
        arguments:
            minProbability: %phpstanCwe.minProbability%
        tags:
            - phpstan.rules.rule
