services:
    phpstanCwe.cwe78Collector:
        class: Perturbatio\PhpstanCwe\Rules\Cwe78\Cwe78Collector
        tags:
            - phpstan.collector
    -
        class: Perturbatio\PhpstanCwe\Rules\Cwe78\Cwe78IgnoreCollector
        tags:
            - phpstan.collector
    -
        class: Perturbatio\PhpstanCwe\Rules\Cwe78\Cwe78Rule
        arguments:
            minProbability: %phpstanCwe.minProbability%
        tags:
            - phpstan.rules.rule
