{
    "name": "perturbatio/phpstan-cwe",
    "description": "Identify *potential* CWE (Common Weakness Enumeration) vulnerabilities in your application",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Perturbatio\\PhpstanCwe\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Kris Kelly",
            "email": "me@perturbatio.com"
        }
    ],
    "scripts": {
        "format": "pint",
        "format:check": "pint --test",
        "test": "pest",
        "test:coverage": "pest --coverage",
        "test:coverage:check": "pest --coverage --min=100",
        "analyse": "phpstan analyse"
    },
    "require-dev": {
        "pestphp/pest": "5.*",
        "laravel/pint": "^1.32"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "require": {
        "phpstan/phpstan": "^2.1",
        "php": "^8.3"
    }
}
